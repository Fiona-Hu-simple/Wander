{
  "name": "wander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "test:dev": "node --test tests/dev.test.mjs",
    "test:ui": "node --test tests/browser.test.mjs tests/chat-browser.test.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "axios": "^1.15.0",
    "dompurify": "^3.4.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.1",
    "vant": "^3.4.3",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
